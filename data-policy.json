{
  "schemaVersion": "1.0",
  "effectiveAt": "2026-09-15T04:40:00.000Z",
  "rules": {
    "appendMergeOnly": true,
    "neverDeleteJobs": true,
    "neverDeleteSources": true,
    "archiveConfirmedClosures": false,
    "retainTemporarilyUnreachable": true,
    "abortUnexpectedLiveCountDecrease": true,
    "requirePerRecordArchiveReason": true,
    "stableJobIds": true,
    "stableSourceIds": true,
    "retainExistingJobsIndefinitely": true,
    "refreshLastVerifiedOnlyWithEvidence": true,
    "preserveOriginalPostedAt": true,
    "preserveOriginalDiscoveredAt": true,
    "closedJobsRemainListedWithStatus": true
  },
  "datasets": {
    "activeJobs": "jobs.json",
    "archivedJobs": "jobs-archive.json",
    "jobHistory": "job-history.json",
    "quarantine": "quarantine.json",
    "sourceRegistry": "source-registry.json",
    "runReports": "run-reports.json"
  }
}
